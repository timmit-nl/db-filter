{
    "name": "timmit/db-filter",
    "description": "A simple DB filter layer in PHP",
    "keywords": [
        "database",
        "filter",
        "DB filter"
    ],
    "license": "MIT",
    "homepage": "http://www.TiMMiT.nl/",
    "authors": [
        {
            "name": "Tim Schoondergang",
            "email": "Tim.Schoondergang@TiMMiT.nl",
            "homepage": "http://www.TiMMiT.nl"
        }
    ],
    "require": {
        "php": ">=8.0",
        "timmit/db-mysql": ">=v11.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.4.8",
        "phpstan/phpstan-strict-rules": "^1.1",
        "phpstan/phpstan-deprecation-rules": "^1.0",
        "timmit/php-docblock-checker": "^1.11",
        "phpunit/phpunit": "10.5.62"
    },
    "autoload": {
        "psr-4": {
            "TiMMiT\\DBFilter\\": "src/TiMMiT/DBFilter"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "test\\php\\phpunit\\": "test/php/phpunit"
        }
    }
}
